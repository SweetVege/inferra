# Copy to services/api/.env for local development. Every setting has a working default except the
# model, which agent runs need.

# INFERRA_DATABASE_URL=postgresql://inferra:inferra@localhost:5432/inferra   # default: local SQLite file
# INFERRA_SECRET_KEY=change-me
# INFERRA_WEB_ORIGIN=http://localhost:3000

# Claude, used by the agents. Set the model id you want the agents to run on.
INFERRA_LLM_MODEL=
ANTHROPIC_API_KEY=

# GitHub OAuth (optional locally; without it a dev sign-in is offered).
# Callback URL: <INFERRA_WEB_ORIGIN>/api/auth/github/callback
# INFERRA_GITHUB_CLIENT_ID=
# INFERRA_GITHUB_CLIENT_SECRET=

# S3-compatible storage for production (e.g. Cloudflare R2).
# INFERRA_STORAGE_BACKEND=s3
# INFERRA_S3_BUCKET=
# INFERRA_S3_ENDPOINT_URL=
# INFERRA_S3_ACCESS_KEY_ID=
# INFERRA_S3_SECRET_ACCESS_KEY=
